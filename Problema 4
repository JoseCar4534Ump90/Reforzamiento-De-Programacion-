#include<iostream>
using namespace std;

int main(){    
    int opcion = 0, cantidad = 0;    
    float total = 0, subtotal = 0;

    do    
    {        
        cout<<"===== MENU ====="<<endl;        
        cout<<"1. Desarrollo Web"<<endl;        
        cout<<"2. Soporte Tecnico"<<endl;        
        cout<<"3. Hosting"<<endl;        
        cout<<"4. Marketing Digital"<<endl;        
        cout<<"5. Salir"<<endl;        
        cout<<"Seleccione opcion: ";        
        cin>>opcion;        

        if (opcion >= 1 && opcion <= 4) 
        {
            cout<<"Ingrese cantidad: ";        
            cin>>cantidad; // ERROR CORREGIDO: Leer la cantidad ANTES de calcular el subtotal

            switch(opcion)        
            {            
                case 1:                
                    subtotal = 2500 * cantidad; // Se asume que también aplica por cantidad               
                    break;            
                case 2:                
                    subtotal = 800 * cantidad;                
                    break;            
                case 3:                
                    subtotal = 500 * cantidad;                
                    break;            
                case 4:                
                    subtotal = 1500 * cantidad;                
                    break;        
            }        
            total = total + subtotal; // ERROR CORREGIDO: Acumular el total de forma aditiva
            cout<<"Subtotal: "<<subtotal<<endl;    
        }
        else if (opcion == 5)
        {
            cout<<"Saliendo..."<<endl;
        }
        else 
        {
            cout<<"Opcion invalida"<<endl;
        }

    } while(opcion != 5); // ERROR CORREGIDO: Comparación lógica correcta (!=)

    cout<<"Total general: "<<total<<endl;    
    return 0;
}
