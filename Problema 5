#include<iostream>
using namespace std;

int main(){    
    int opcion = 0; // ERROR CORREGIDO: Inicializada para evitar valores basura
    int cantidad;    
    int stock = 100;

    while(opcion != 4)    
    {        
        cout<<"\n===== INVENTARIO ====="<<endl;        
        cout<<"1. Entrada de productos"<<endl;        
        cout<<"2. Salida de productos"<<endl;        
        cout<<"3. Consultar stock"<<endl;        
        cout<<"4. Salir"<<endl;        
        cout<<"Seleccione opcion: ";        
        cin>>opcion;

        switch(opcion)        
        {            
            case 1:                
                cout<<"Cantidad de entrada: ";                
                cin>>cantidad;                
                stock = stock + cantidad; // ERROR CORREGIDO: Sumar al stock actual               
                break;            
            case 2:                
                cout<<"Cantidad de salida: ";                
                cin>>cantidad;                
                if (cantidad <= stock) {
                    stock = stock - cantidad; // ERROR CORREGIDO: Restar al stock actual
                } else {
                    cout << "Error: No hay suficiente stock disponible." << endl;
                }                
                break;            
            case 3:                
                // ERROR CORREGIDO: Se eliminó el bucle 'for' defectuoso que impedía la impresión
                cout<<"Stock actual: "<<stock<<endl;                
                break;            
            case 4:                
                cout<<"Fin del programa"<<endl;                
                break;            
            default:                
                cout<<"Opcion incorrecta"<<endl;        
        }    
    }    
    return 0;
}
